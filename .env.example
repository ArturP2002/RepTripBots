# Запуск каналов: true/false — какие боты поднимать в main.py
TELEGRAM_ENABLED=true
WHATSAPP_ENABLED=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://reptrip:reptrip@localhost:5433/reptrip

# Telegram
TELEGRAM_BOT_TOKEN=
# Telegram username бота без @ (для deep-link t.me/...)
TELEGRAM_BOT_USERNAME=
# ID владельцев через запятую (Confirm / создание Trip)
OWNER_TELEGRAM_IDS=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Номер бота для ссылок wa.me: только цифры с кодом страны, без + и пробелов
WHATSAPP_DISPLAY_PHONE=
WHATSAPP_VERIFY_TOKEN=reptrip_verify
WHATSAPP_API_VERSION=v21.0

# Часовые пояса
DEFAULT_TIMEZONE=Europe/Moscow
TIMEZONE_KZ=Asia/Almaty
TIMEZONE_UZ=Asia/Tashkent

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=secrets/google_credentials.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
# Цвет встреч в календаре: 1–11 (11=красный, 6=оранжевый, 9=синий, 10=зелёный)
GOOGLE_EVENT_COLOR_ID=11
# Цвет полоски на весь день (метка дат с встречами): 5=жёлтый
GOOGLE_DAY_HIGHLIGHT_COLOR_ID=5

# Публичный URL (туннель/VPS) для WhatsApp webhook и /go/{token}
PUBLIC_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO
